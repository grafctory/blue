{
  "tsconfig": "./tsconfig.build.json",
  "plugin": [
    "./typedoc.mjs"
  ],
  "excludeInternal": true,
  "includeVersion": true,
  "sortEntryPoints": false,
  "sort": [
    "source-order"
  ],
  "categorizeByGroup": true,
  "groupOrder": [
    "Variables",
    "Interfaces",
    "Type Aliases",
    "*"
  ],
  "useFirstParagraphOfCommentAsSummary": true,
  "favicon": "https://www.metreeca.com/200.svg",
  "sourceLinkExternal": true,
  "markdownLinkExternal": true,
  "externalSymbolLinkMappings": {
    "global": {
      "RangeError": "https://developer.mozilla.org/docs/Web/JavaScript/Reference/Global_Objects/RangeError",
      "TypeError": "https://developer.mozilla.org/docs/Web/JavaScript/Reference/Global_Objects/TypeError"
    },
    "typescript": {
      "RegExp": "https://developer.mozilla.org/docs/Web/JavaScript/Reference/Global_Objects/RegExp",
      "NoInfer": "https://www.typescriptlang.org/docs/handbook/utility-types.html#noinfertype",
      "NumberConstructor.MIN_SAFE_INTEGER": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Number/MIN_SAFE_INTEGER",
      "NumberConstructor.MAX_SAFE_INTEGER": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Number/MAX_SAFE_INTEGER"
    },
    "@grafctory/core": {
      "Trace": "https://grafctory.github.io/core/types/trace.Trace.html",
      "Issue": "https://grafctory.github.io/core/types/trace.Issue.html",
      "Validator": "https://grafctory.github.io/core/types/trace.Validator.html",
      "TraceError": "https://grafctory.github.io/core/classes/trace.TraceError.html",
      "Relay": "https://grafctory.github.io/core/interfaces/relay.Relay.html",
      "Identifier": "https://grafctory.github.io/core/types/index.Identifier.html",
      "Lazy": "https://grafctory.github.io/core/types/index.Lazy.html",
      "Eager": "https://grafctory.github.io/core/types/index.Eager.html",
      "Optional": "https://grafctory.github.io/core/types/index.Optional.html",
      "base": "https://grafctory.github.io/core/variables/resource.base.html",
      "Namespace": "https://grafctory.github.io/core/types/resource.Namespace.html",
      "Variant": "https://grafctory.github.io/core/types/resource.Variant.html",
      "TagRange": "https://grafctory.github.io/core/types/language.TagRange.html"
    },
    "@grafctory/qest": {
      "Resource": "https://grafctory.github.io/qest/types/state.Resource.html",
      "Reference": "https://grafctory.github.io/qest/types/state.Reference.html",
      "Value": "https://grafctory.github.io/qest/types/state.Value.html",
      "Values": "https://grafctory.github.io/qest/types/state.Values.html",
      "Dictionary": "https://grafctory.github.io/qest/types/state.Dictionary.html",
      "Template": "https://grafctory.github.io/qest/types/model.Template.html",
      "Projection": "https://grafctory.github.io/qest/types/model.Projection.html",
      "Probe": "https://grafctory.github.io/qest/types/model.Probe.html"
    }
  },
  "navigationLinks": {
    "GitHub": "https://github.com/grafctory/blue"
  },
  "githubPages": false,
  "hideGenerator": true,
  "customFooterHtml": "<a href='https://www.metreeca.com/' style='display: flex; align-items: center; gap: 0.25em'><img src='https://www.metreeca.com/200.svg' alt='Metreeca' style='width: 1.25em; height: 1.25em;'/><span>Copyright © 2025-2026 Metreeca · Grafctory™ is a trademark of Metreeca srl</span></a>",
  "headings": {
    "readme": false
  }
}
